# Example only. The recommended setup script now generates a real local file at:
#   ~/.config/game_creater/grounded_sam2.env
# Paths below assume scripts/setup_grounded_sam2_wsl.sh used its default location.

GAME_CREATER_MODE=grounded_sam2_local
GAME_CREATER_DEVICE=auto
GAME_CREATER_BOX_THRESHOLD=0.35
GAME_CREATER_TEXT_THRESHOLD=0.25

# Duplicate filtering. First suppress overlapping GroundingDINO boxes before
# SAM2 to reduce segmentation work, then suppress near-identical SAM masks.
GAME_CREATER_DEDUPE_IOU=0.65
GAME_CREATER_CROSS_LABEL_DEDUPE_IOU=0.92
GAME_CREATER_MASK_DEDUPE_IOU=0.86
GAME_CREATER_CROSS_LABEL_MASK_DEDUPE_IOU=0.96

# GroundingDINO compiles a CUDA Deformable Attention operator.
# This should point to the CUDA toolkit inside WSL/Linux and contain bin/nvcc.
CUDA_HOME=/usr/local/cuda

GROUNDING_DINO_CONFIG=/home/YOUR_USER/.local/share/game_creater/Grounded-SAM-2/grounding_dino/groundingdino/config/GroundingDINO_SwinT_OGC.py
GROUNDING_DINO_CHECKPOINT=/home/YOUR_USER/.local/share/game_creater/Grounded-SAM-2/gdino_checkpoints/groundingdino_swint_ogc.pth

SAM2_MODEL_CONFIG=configs/sam2.1/sam2.1_hiera_l.yaml
SAM2_CHECKPOINT=/home/YOUR_USER/.local/share/game_creater/Grounded-SAM-2/checkpoints/sam2.1_hiera_large.pt

# Filled by setup_grounded_sam2_wsl.sh for reproducibility.
GAME_CREATER_GSAM_COMMIT=<grounded-sam-2-commit-sha>
